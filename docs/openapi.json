    "/v1/generate": {
      "post": {
        "tags": [
          "Morphology"
        ],
        "summary": "Generate a supported v1 Shona verb form.",
        "operationId": "generateForm",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GenerateRequest"
              },
              "example": {
                "lemma_public_id": "lemma_abc123",
                "features": {
                  "generation_type": "verb_form",
                  "subject": {
                    "type": "person",
                    "person": "first",
                    "number": "singular"
                  },
                  "tense_aspect": "present",
                  "polarity": "positive"
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Generated form.",
